# ============================================================================
# LOCUS MOBILE - Environment Configuration (template)
# Copy this file to mobile/.env and fill in the values.
# Expo only reads .env from this mobile/ folder, not the repo root.
# mobile/.env is git-ignored; never put real secrets in this template.
# ============================================================================

# Backend API URL as seen FROM THE PHONE:
#   Android emulator:  http://10.0.2.2:8000/api
#   iOS simulator:     http://localhost:8000/api
#   Physical phone:    http://<your computer's LAN IP>:8000/api  (also add that IP to DJANGO_ALLOWED_HOSTS)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api

# Native Google Maps keys, read by app.config.js at build time.
# Only needed for your own builds (EAS / store builds); Expo Go has its own key.
# Android: key with "Maps SDK for Android" enabled, restricted to package com.locusmemories.app.
GOOGLE_MAPS_ANDROID_API_KEY=
# iOS: only needed if the app is switched to Google Maps on iOS (it uses Apple Maps today).
GOOGLE_MAPS_IOS_API_KEY=
