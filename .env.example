# ============================================================================
# LOCUS - Environment Configuration (template)
# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored; this template is committed, so never put real secrets here.
#
# Read by: Django backend (backend/locus_backend/settings.py),
#          Web portal (web/vite.config.ts -> envDir ".."),
#          docker-compose.yml.
# The mobile app has its own file: see mobile/.env.example.
# ============================================================================

# --- Django Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Comma-separated. 10.0.2.2 = Android emulator. Add your computer's LAN IP
# (e.g. 192.168.1.x) so a physical phone can reach the API.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Database: PostgreSQL + PostGIS (docker-compose overrides POSTGRES_HOST to "db" for the backend container)
POSTGRES_DB=locus
POSTGRES_USER=locus_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Only needed if GeoDjango can't find GDAL/GEOS on its own, e.g. Homebrew on Apple Silicon:
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# Default per-user storage quota in megabytes (modifiable per user in Django Admin)
DEFAULT_STORAGE_QUOTA_MB=500

# --- Web Portal: Google Maps (optional) ---
# Leave the key blank to use the free OpenStreetMap/Leaflet map.
# Key needs the "Maps JavaScript API" enabled; restrict it to your site's referrers.
VITE_GOOGLE_MAPS_API_KEY=
# Required for map pins (AdvancedMarker) once a key is set. Create one under
# Google Cloud Console > Map Management, or use DEMO_MAP_ID for development.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- Web Portal: API ---
VITE_API_BASE_URL=http://localhost:8000/api
