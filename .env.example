# ============================================================================
# LOCUS - Environment Configuration
# Copy this file to .env and fill in your API keys
# ============================================================================

# --- Django Backend ---
DJANGO_SECRET_KEY=locus-dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.100

# Database Mode:
# Set USE_POSTGIS=True when running with PostgreSQL/PostGIS (docker-compose)
# Set USE_POSTGIS=False for zero-dependency local dev with SQLite + Haversine math
USE_POSTGIS=False
POSTGRES_DB=locus
POSTGRES_USER=locus_user
POSTGRES_PASSWORD=locus_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Default per-user storage quota in megabytes (modifiable per user in Django Admin)
DEFAULT_STORAGE_QUOTA_MB=500

# --- Google Maps API ---
# Used by Web Portal (Maps JavaScript API) and Mobile App (Maps SDK for iOS/Android)
VITE_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Frontend API Base URLs ---
VITE_API_BASE_URL=http://localhost:8000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
