{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🐍 Backend: Start Django API & Admin (Port 8000)",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe manage.py runserver 0.0.0.0:8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🌐 Web: Start End-User Creator & Map Portal (Port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "📱 Mobile: Start Expo Dev Server (iOS & Android)",
      "type": "shell",
      "command": "npx expo start",
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Start PostGIS & Backend Stack",
      "type": "shell",
      "command": "docker compose up --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
